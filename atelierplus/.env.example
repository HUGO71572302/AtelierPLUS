# Connexion poolée pour les requêtes runtime sur Vercel.
# Dans Neon, activez « Connection pooling » et choisissez la région Frankfurt (eu-central-1).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.eu-central-1.aws.neon.tech/atelierplus?sslmode=require

# Connexion directe pour Drizzle Kit (schéma/migrations). Elle est facultative si vous
# utilisez une seule URL compatible : drizzle.config.ts retombera alors sur DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.eu-central-1.aws.neon.tech/atelierplus?sslmode=require

# À générer avec : openssl rand -base64 32
# Gardez la même valeur sur Preview/Production afin de ne pas invalider toutes les sessions.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
